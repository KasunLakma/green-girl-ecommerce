generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  colors      String?  @default("")
  imageAlt    String   @default("")
  sizes       String?  @default("")
  image       String?  @default("")
  stock       Int?     @default(0)
}

model Order {
  id            String   @id @default(uuid())
  name          String
  email         String
  contactNumber String?
  address       String
  district      String?
  totalAmount   Float
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String?
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  type      String   @default("Customer (Auto-Created via Order)")
  status    String   @default("Pending Approval")
  spend     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


